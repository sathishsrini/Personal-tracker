# ---------------------------------------------------------------------------
# Storage driver
#   sheets -> Google Sheets (primary)
#   local  -> ./data/local-db.json (useful before Google is configured)
# If unset, "sheets" is used when credentials + spreadsheet id are present,
# otherwise "local".
# ---------------------------------------------------------------------------
STORAGE_DRIVER=sheets

# The id from the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Service account credentials. Use ONE of the following:
#   1) Path to the downloaded JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
#   2) Or the individual fields (keep the \n sequences in the private key)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Only used when STORAGE_DRIVER=local (or no Sheets credentials are set).
# Defaults to ./data/local-db.json.
# TRACKER_LOCAL_DB=./data/local-db.json
