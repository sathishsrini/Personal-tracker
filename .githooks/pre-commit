#!/bin/sh
# Secret guard. Blocks the two ways this repo has actually leaked before:
# a service-account key under credentials/, and a raw private key pasted
# into any file. Runs on staged content only, so it stays fast.
#
# Enable with: npm run hooks:install
# Bypass (only when you are certain): git commit --no-verify
#
# The pattern has three arms because grep is line-based:
#   1. a PEM header at end of line  -> a real multi-line key file
#   2. a header followed by real base64 -> a key inlined in .env or JSON
#   3. service-account JSON field names
# The bracket groups ([ ], [_]) keep this file from matching itself, and
# requiring actual key material keeps the documented placeholder in
# .env.example from tripping the guard.
KEY_PATTERN='PRIVATE[ ]KEY-----$|PRIVATE[ ]KEY-----[^A-Za-z0-9+/]{0,8}[A-Za-z0-9+/]{40,}|"private[_]key[_]id"|"type": *"service[_]account"'

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

fail=0

# 1. Anything under credentials/, or a dotenv file that is not a template.
blocked=$(printf '%s\n' "$staged" \
  | grep -E '(^|/)credentials/|(^|/)\.env($|\.)' \
  | grep -vE '(^|/)\.env\.(example|sample|template)$' || true)
if [ -n "$blocked" ]; then
  echo "pre-commit: refusing to commit credential/env files:" >&2
  printf '  %s\n' $blocked >&2
  fail=1
fi

# 2. Key material in the staged content itself.
for f in $staged; do
  case "$f" in
    package-lock.json|*.min.js|*.map|.githooks/*|.github/workflows/*) continue ;;
  esac
  if git show ":$f" 2>/dev/null | grep -qE "$KEY_PATTERN"; then
    echo "pre-commit: private-key material detected in $f" >&2
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "Nothing was committed. Move the secret out of the tree, or use --no-verify if this is a false positive." >&2
  exit 1
fi
exit 0
